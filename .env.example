# Скопируйте этот файл в .env и заполните своими значениями

# Поддомен amoCRM, без .amocrm.ru
AMO_SUBDOMAIN=bitkoganfinance

# Долгосрочный токен приватной интеграции:
# Настройки -> Интеграции -> ваша интеграция -> Ключи и доступы -> Создать долгосрочный токен
AMO_ACCESS_TOKEN=

# id воронки Customer Success (взят из URL /leads/pipeline/<id>)
PIPELINE_ID=7163002

# id ваших 4 сотрудниц через запятую (id ответственного, не путать с id сделки)
# Узнать id: GET /api/v4/users или посмотреть в адресной строке при фильтре "Менеджеры"
EMPLOYEE_IDS=12865498,13847354,13847362,13847374

# Таймзона для группировки по часам и определения границ "вчера"
TIMEZONE=Europe/Moscow

PORT=3000
